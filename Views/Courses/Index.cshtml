@model IEnumerable<MvcApp.Models.Course>

@{
    ViewData["Title"] = "Список курсов";
}

<h1>Список курсов</h1>
<p>
    <a asp-action="Create" class="btn btn-custom-red">Создать новый курс</a>
</p>

<div class="rounded-table">
    <table class="table table-courses mb-0">
        <thead>
            <tr>
                <th>@Html.DisplayNameFor(model => model.Title)</th>
                <th>@Html.DisplayNameFor(model => model.Instructor)</th>
                <th>@Html.DisplayNameFor(model => model.Credits)</th>
                <th>@Html.DisplayNameFor(model => model.StartDate)</th>
                <th>@Html.DisplayNameFor(model => model.EndDate)</th>
                <th>Длительность (дней)</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@Html.DisplayFor(modelItem => item.Title)</td>
                    <td>@Html.DisplayFor(modelItem => item.Instructor)</td>
                    <td>@Html.DisplayFor(modelItem => item.Credits)</td>
                    <td>@Html.DisplayFor(modelItem => item.StartDate)</td>
                    <td>@Html.DisplayFor(modelItem => item.EndDate)</td>
                    <td>@item.GetDuration()</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-custom-red">Изменить</a>
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-custom-red">Подробнее...</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-custom-red">Удалить</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>