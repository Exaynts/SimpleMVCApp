@model IEnumerable<MvcApp.Models.Course>
@using System.Linq

@{
    ViewData["Title"] = "Курсы по кредитам";
    var grouped = Model.GroupBy(c => c.Credits).OrderBy(g => g.Key);
}

<h1>Курсы по кредитам</h1>

@if (!Model.Any())
{
    <div class="alert alert-warning">Нет курсов в базе данных</div>
}
else
{
    <div class="accordion" id="creditsAccordion">
        @{ int index = 0; }
        @foreach (var group in grouped)
        {
            <div class="accordion-item">
                <h2 class="accordion-header">
                    <button class="accordion-button @(index != 0 ? "collapsed" : "")" 
                            type="button" data-bs-toggle="collapse" 
                            data-bs-target="#collapse@(index)">
                        <strong>Кредитов: @group.Key</strong>
                        <span class="badge bg-secondary ms-2">@group.Count() курсов</span>
                    </button>
                </h2>
                <div id="collapse@(index)" 
                     class="accordion-collapse collapse @(index == 0 ? "show" : "")"
                     data-bs-parent="#creditsAccordion">
                    <div class="accordion-body">
                        <table class="table table-striped">
                            <thead>
                                <tr>
                                    <th>Название</th>
                                    <th>Преподаватель</th>
                                    <th>Часы</th>
                                    <th>Длительность (дней)</th>
                                    <th>Действия</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var course in group)
                                {
                                    <tr>
                                        <td>@course.Title</td>
                                        <td>@course.Instructor</td>
                                        <td>@course.Hours</td>
                                        <td>@course.GetDuration()</td>
                                        <td><a asp-action="Details" asp-route-id="@course.Id">Детали</a></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            index++;
        }
    </div>
}

<div class="mt-3">
    <a asp-action="Index" class="btn btn-secondary">← Назад к списку</a>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            console.log('Страница группировки по кредитам загружена');
        });
    </script>
}